@page
@model wt_lab8_8razor_postgresql_cherevan.Pages.Tasks.IndexModel
@{
    ViewData["Title"] = "Список задач";
}

<div class="mb-3">
    <a href="/" class="text-decoration-none">
        <i class="bi bi-arrow-left"></i> На главную
    </a>
</div>

<!-- container -->
<div class="container py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Задачи проекта</h1>
            <p class="text-muted">Всего задач: @Model.TaskItem.Count</p>
            
            <!-- ФОРМА ПОИСКА -->
            <form method="get" class="mt-3 d-flex gap-2">
                <input type="text" name="Search" value="@Model.Search" placeholder="Поиск по названию..." class="form-control w-auto" />
                <button type="submit" class="btn btn-outline-secondary">Найти</button>
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-page="./Index" class="btn btn-outline-danger">Сбросить</a>
                }
            </form>
            <!-- КОНЕЦ ФОРМЫ ПОИСКА -->
            
        </div>
        <!-- Кнопка Добавить с иконкой -->
        <a asp-page="/Tasks/Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Добавить
        </a>
    </div>

    <!-- ================= КАРТОЧКИ ================= -->
    <h3 class="mb-3 text-secondary">Каталог</h3>
    <div class="row g-4 mb-5">
        @foreach (var t in Model.TaskItem)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 align-self-start">ID: @t.Id</span>
                        
                        <h5 class="card-title">@t.Title</h5>
                        
                        <p class="text-muted mb-1">Проект: <b>@t.Project</b></p>
                        <p class="text-muted mb-1">Исполнитель: <b>@t.Assignee</b></p>
                        
                        <span class="badge bg-info text-dark mb-3 align-self-start">
                            <i class="bi bi-clock-history"></i> @t.Status
                        </span>
                        
                        <p class="fs-4 fw-bold mt-auto">@t.EstimateHours ч.</p>
                        
                        <div class="d-flex gap-2 mt-2">
                            <a asp-page="/Tasks/Details" asp-route-id="@t.Id" class="btn btn-outline-primary flex-grow-1">
                                <i class="bi bi-info-circle"></i> Подробнее
                            </a>
                            
                            <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" onsubmit="return confirm('Вы уверены, что хотите удалить эту задачу?');">
                                <button type="submit" class="btn btn-outline-danger" title="Удалить">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ================= ТАБЛИЦА ================= -->
    <h3 class="mb-3 text-secondary">Таблица всех задач</h3>
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover bg-white mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Проект</th>
                    <th>Исполнитель</th>
                    <th>Оценка</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.TaskItem)
                {
                    <tr>
                        <td>@t.Id</td>
                        <td>@t.Title</td>
                        <td>@t.Project</td>
                        <td>@t.Assignee</td>
                        <td>@t.EstimateHours ч.</td>
                        <td>@t.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>